dali:tp-uldl-mptcp  rdf:type skos:Concept ; skos:prefLabel "UL/DL MPTCP"@en ; skos:inScheme dali:TrafficPatternScheme ; skos:notation "UL/DL MPTCP" .
dali:tp-dl-udp      rdf:type skos:Concept ; skos:prefLabel "DL UDP"@en       ; skos:inScheme dali:TrafficPatternScheme ; skos:notation "DL UDP" .
dali:tp-dl-tcp      rdf:type skos:Concept ; skos:prefLabel "DL TCP"@en       ; skos:inScheme dali:TrafficPatternScheme ; skos:notation "DL TCP" .
dali:tp-dl-mptcp    rdf:type skos:Concept ; skos:prefLabel "DL MPTCP"@en     ; skos:inScheme dali:TrafficPatternScheme ; skos:notation "DL MPTCP" .
dali:tp-ul-udp      rdf:type skos:Concept ; skos:prefLabel "UL UDP"@en       ; skos:inScheme dali:TrafficPatternScheme ; skos:notation "UL UDP" .
