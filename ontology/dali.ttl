dali:ObservationPointVScheme
    rdf:type        skos:ConceptScheme ;
    skos:prefLabel  "6G-DALI Vertical Observation Points"@en ;
    dct:description "Vertical (protocol stack) observation layers."@en .

dali:obs-v-radio    rdf:type skos:Concept ; skos:prefLabel "Radio Level"@en           ; skos:inScheme dali:ObservationPointVScheme ; skos:notation "Radio Level" .
dali:obs-v-network  rdf:type skos:Concept ; skos:prefLabel "Network Layer"@en         ; skos:inScheme dali:ObservationPointVScheme ; skos:notation "Network Layer" .
dali:obs-v-app      rdf:type skos:Concept ; skos:prefLabel "Application Layer"@en     ; skos:inScheme dali:ObservationPointVScheme ; skos:notation "Application Layer" .
dali:obs-v-compute  rdf:type skos:Concept ; skos:prefLabel "Compute Resource-level"@en; skos:inScheme dali:ObservationPointVScheme ; skos:notation "Compute Resource-level" .
dali:obs-v-cross    rdf:type skos:Concept ; skos:prefLabel "cross-layer"@en           ; skos:inScheme dali:ObservationPointVScheme ; skos:notation "cross-layer" .
dali:obs-v-other    rdf:type skos:Concept ; skos:prefLabel "other"@en                 ; skos:inScheme dali:ObservationPointVScheme ; skos:notation "other" .

# --- Service Type ---

dali:ServiceTypeScheme
    rdf:type        skos:ConceptScheme ;
    skos:prefLabel  "6G-DALI DataOps Service Types"@en ;
    dct:description "Allowed values for dali:serviceType on dcat:DataService resources."@en .

dali:svc-transformation    rdf:type skos:Concept ; skos:prefLabel "Transformation"@en    ; skos:inScheme dali:ServiceTypeScheme ; skos:notation "Transformation" .
dali:svc-qualitycheck      rdf:type skos:Concept ; skos:prefLabel "Quality Check"@en     ; skos:inScheme dali:ServiceTypeScheme ; skos:notation "QualityCheck" .
dali:svc-augmentation      rdf:type skos:Concept ; skos:prefLabel "Augmentation"@en      ; skos:inScheme dali:ServiceTypeScheme ; skos:notation "Augmentation" .
dali:svc-aggregation       rdf:type skos:Concept ; skos:prefLabel "Aggregation"@en       ; skos:inScheme dali:ServiceTypeScheme ; skos:notation "Aggregation" .
dali:svc-anonymisation     rdf:type skos:Concept ; skos:prefLabel "Anonymisation"@en     ; skos:inScheme dali:ServiceTypeScheme ; skos:notation "Anonymisation" .
dali:svc-featureengineering rdf:type skos:Concept ; skos:prefLabel "Feature Engineering"@en ; skos:inScheme dali:ServiceTypeScheme ; skos:notation "Feature Engineering" .


# =============================================================================
# 10. DQV QUALITY DIMENSIONS
# =============================================================================

dali:dqv/completeness
    rdf:type        dqv:Dimension ;
    rdfs:label      "Completeness"@en ;
    rdfs:comment    "The degree to which all required data values are present and non-null."@en ;
    rdfs:isDefinedBy <https://dali-project.eu/ns> .

dali:dqv/accuracy
    rdf:type        dqv:Dimension ;
    rdfs:label      "Accuracy"@en ;
    rdfs:comment    "The degree to which data correctly represents the real-world phenomenon it describes."@en ;
    rdfs:isDefinedBy <https://dali-project.eu/ns> .

dali:dqv/timeliness
    rdf:type        dqv:Dimension ;
    rdfs:label      "Timeliness"@en ;
    rdfs:comment    "The degree to which data is sufficiently up-to-date for its intended use."@en ;
    rdfs:isDefinedBy <https://dali-project.eu/ns> .

dali:dqv/consistency
    rdf:type        dqv:Dimension ;
    rdfs:label      "Consistency"@en ;
    rdfs:comment    "The degree to which data adheres to defined schema, formats, and value constraints."@en ;
    rdfs:isDefinedBy <https://dali-project.eu/ns> .

dali:dqv/uniqueness
    rdf:type        dqv:Dimension ;
    rdfs:label      "Uniqueness"@en ;
    rdfs:comment    "The degree to which data is free from duplicate records."@en ;
    rdfs:isDefinedBy <https://dali-project.eu/ns> .

dali:dqv/validity
    rdf:type        dqv:Dimension ;
    rdfs:label      "Validity"@en ;
    rdfs:comment    "The degree to which data values conform to defined formats, ranges, and business rules."@en ;
    rdfs:isDefinedBy <https://dali-project.eu/ns> .

dali:dqv/modelperformance
    rdf:type        dqv:Dimension ;
    rdfs:label      "Model Performance"@en ;
    rdfs:comment    "Quantitative performance characteristics of an ML model on an evaluation dataset."@en ;
    rdfs:isDefinedBy <https://dali-project.eu/ns> .


# =============================================================================
# 11. DQV QUALITY METRICS — Dataset quality
# =============================================================================

dali:metric/completeness-generic
    rdf:type                dqv:Metric ;
    rdfs:label              "Generic completeness"@en ;
    rdfs:comment            "Fraction of non-null values across all columns (GE: expect_column_values_to_not_be_null)."@en ;
    dqv:inDimension         dali:dqv/completeness ;
    dqv:expectedDataType    xsd:decimal ;
    rdfs:isDefinedBy        <https://dali-project.eu/ns> .

dali:metric/row-count
    rdf:type                dqv:Metric ;
    rdfs:label              "Row count"@en ;
    rdfs:comment            "Total number of records in the dataset (GE: expect_table_row_count_to_be_between)."@en ;
    dqv:inDimension         dali:dqv/completeness ;
    dqv:expectedDataType    xsd:integer ;
    rdfs:isDefinedBy        <https://dali-project.eu/ns> .

dali:metric/schema-conformance
    rdf:type                dqv:Metric ;
    rdfs:label              "Schema conformance"@en ;
    rdfs:comment            "Whether the dataset conforms to its declared column schema (GE: expect_column_to_exist, expect_column_values_to_be_of_type)."@en ;
    dqv:inDimension         dali:dqv/consistency ;
    dqv:expectedDataType    xsd:boolean ;
    rdfs:isDefinedBy        <https://dali-project.eu/ns> .

dali:metric/value-range-validity
    rdf:type                dqv:Metric ;
    rdfs:label              "Value range validity"@en ;
    rdfs:comment            "Fraction of values within the expected range (GE: expect_column_values_to_be_between)."@en ;
    dqv:inDimension         dali:dqv/validity ;
    dqv:expectedDataType    xsd:decimal ;
    rdfs:isDefinedBy        <https://dali-project.eu/ns> .

dali:metric/uniqueness-rate
    rdf:type                dqv:Metric ;
    rdfs:label              "Uniqueness rate"@en ;
    rdfs:comment            "Fraction of unique rows in the dataset (GE: expect_column_values_to_be_unique)."@en ;
    dqv:inDimension         dali:dqv/uniqueness ;
    dqv:expectedDataType    xsd:decimal ;
    rdfs:isDefinedBy        <https://dali-project.eu/ns> .

dali:metric/data-freshness-days
    rdf:type                dqv:Metric ;
    rdfs:label              "Data freshness (days)"@en ;
    rdfs:comment            "Number of days elapsed since the dataset was last updated."@en ;
    dqv:inDimension         dali:dqv/timeliness ;
    dqv:expectedDataType    xsd:integer ;
    rdfs:isDefinedBy        <https://dali-project.eu/ns> .


# =============================================================================
# 12. DQV QUALITY METRICS — ML Model performance
# =============================================================================

dali:metric/model-accuracy
    rdf:type                dqv:Metric ;
    rdfs:label              "Model accuracy"@en ;
    rdfs:comment            "Classification accuracy of the model on the test set."@en ;
    dqv:inDimension         dali:dqv/modelperformance ;
    dqv:expectedDataType    xsd:decimal ;
    rdfs:isDefinedBy        <https://dali-project.eu/ns> .

dali:metric/model-f1
    rdf:type                dqv:Metric ;
    rdfs:label              "Model F1 score"@en ;
    rdfs:comment            "Macro-averaged F1 score of the model on the test set."@en ;
    dqv:inDimension         dali:dqv/modelperformance ;
    dqv:expectedDataType    xsd:decimal ;
    rdfs:isDefinedBy        <https://dali-project.eu/ns> .

dali:metric/model-precision
    rdf:type                dqv:Metric ;
    rdfs:label              "Model precision"@en ;
    rdfs:comment            "Precision of the model on the test set."@en ;
    dqv:inDimension         dali:dqv/modelperformance ;
    dqv:expectedDataType    xsd:decimal ;
    rdfs:isDefinedBy        <https://dali-project.eu/ns> .

dali:metric/model-recall
    rdf:type                dqv:Metric ;
    rdfs:label              "Model recall"@en ;
    rdfs:comment            "Recall of the model on the test set."@en ;
    dqv:inDimension         dali:dqv/modelperformance ;
    dqv:expectedDataType    xsd:decimal ;
    rdfs:isDefinedBy        <https://dali-project.eu/ns> .

dali:metric/model-mae
    rdf:type                dqv:Metric ;
    rdfs:label              "Mean Absolute Error (MAE)"@en ;
    rdfs:comment            "Mean Absolute Error of the model on the test set (regression tasks)."@en ;
    dqv:inDimension         dali:dqv/modelperformance ;
    dqv:expectedDataType    xsd:decimal ;
    rdfs:isDefinedBy        <https://dali-project.eu/ns> .

dali:metric/model-rmse
    rdf:type                dqv:Metric ;
    rdfs:label              "Root Mean Square Error (RMSE)"@en ;
    rdfs:comment            "Root Mean Square Error of the model on the test set (regression tasks)."@en ;
    dqv:inDimension         dali:dqv/modelperformance ;
    dqv:expectedDataType    xsd:decimal ;
    rdfs:isDefinedBy        <https://dali-project.eu/ns> .

dali:metric/localization-error-m
    rdf:type                dqv:Metric ;
    rdfs:label              "Mean localization error (metres)"@en ;
    rdfs:comment            "Mean Euclidean distance between predicted and ground-truth positions, in metres. Specific to 6G/5G localization models."@en ;
    dqv:inDimension         dali:dqv/modelperformance ;
    dqv:expectedDataType    xsd:decimal ;
    rdfs:isDefinedBy        <https://dali-project.eu/ns> .

dali:metric/inference-latency-ms
    rdf:type                dqv:Metric ;
    rdfs:label              "Inference latency (ms)"@en ;
    rdfs:comment            "Average time in milliseconds to produce one model inference."@en ;
    dqv:inDimension         dali:dqv/modelperformance ;
    dqv:expectedDataType    xsd:decimal ;
    rdfs:isDefinedBy        <https://dali-project.eu/ns> .

dali:metric/model-size-mb
    rdf:type                dqv:Metric ;
    rdfs:label              "Model size (MB)"@en ;
    rdfs:comment            "Size of the serialised model artefact in megabytes."@en ;
    dqv:inDimension         dali:dqv/modelperformance ;
    dqv:expectedDataType    xsd:decimal ;
    rdfs:isDefinedBy        <https://dali-project.eu/ns> .

dali:metric/model-fairness-disparate-impact
    rdf:type                dqv:Metric ;
    rdfs:label              "Disparate impact ratio"@en ;
    rdfs:comment            "Ratio of positive prediction rates between protected and non-protected groups (fairness metric)."@en ;
    dqv:inDimension         dali:dqv/modelperformance ;
    dqv:expectedDataType    xsd:decimal ;
    rdfs:isDefinedBy        <https://dali-project.eu/ns> .