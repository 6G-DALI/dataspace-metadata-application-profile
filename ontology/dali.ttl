# =============================================================================
# 6G-DALI Ontology
# Namespace: https://dali-project.eu/ns#
# Prefix:    dali:
#
# Defines all custom classes, properties, controlled vocabularies (as SKOS
# concept schemes), and named DQV dimensions/metrics introduced by the
# 6G-DALI Metadata Application Profile.
#
# This ontology extends:
#   - DCAT-AP 3.0    (dcat:, dct:)
#   - MLDCAT-AP      (mldcat:)
#   - W3C DQV        (dqv:)
#   - W3C PROV-O     (prov:)
#   - GAIA-X TF      (gax:)
#   - SNS-JU CMT V1.0
# =============================================================================

PREFIX dali:    <https://dali-project.eu/ns#>
PREFIX dcat:    <http://www.w3.org/ns/dcat#>
PREFIX dct:     <http://purl.org/dc/terms/>
PREFIX dqv:     <http://www.w3.org/ns/dqv#>
PREFIX foaf:    <http://xmlns.com/foaf/0.1/>
PREFIX mldcat:  <http://www.w3.org/ns/mldcat#>
PREFIX owl:     <http://www.w3.org/2002/07/owl#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX vann:    <http://purl.org/vocab/vann/>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>


# =============================================================================
# Ontology declaration
# =============================================================================

<https://dali-project.eu/ns>
    rdf:type            owl:Ontology ;
    dct:title           "6G-DALI Metadata Application Profile Ontology"@en ;
    dct:description     "Defines classes, properties, controlled vocabularies, and quality dimensions/metrics for the 6G-DALI Data Space Metadata Application Profile. Covers 5G/6G testbed context (SNS-JU CMT), DataOps service descriptions, MLOps model descriptions (MLDCAT-AP extensions), and W3C DQV quality annotations."@en ;
    dct:created         "2026-03-13"^^xsd:date ;
    dct:modified        "2026-03-13"^^xsd:date ;
    owl:versionInfo     "1.0" ;
    dct:creator         [ rdf:type  foaf:Organization ;
                          foaf:name "6G-DALI Consortium" ;
                          foaf:homepage <https://dali-project.eu> ] ;
    dct:license         <https://creativecommons.org/licenses/by/4.0/> ;
    vann:preferredNamespacePrefix "dali" ;
    vann:preferredNamespaceUri    "https://dali-project.eu/ns#" ;
    rdfs:seeAlso        <https://dataspace.6gdali.eu/catalogue> .


# =============================================================================
# 1. CLASSES
# =============================================================================

# -----------------------------------------------------------------------------
# dali:TestbedContext
# Encapsulates the 5G/6G infrastructure and experiment parameters
# described in the SNS-JU Common Metadata Template (CMT) groups 3A, 3B, 3C.
# -----------------------------------------------------------------------------

dali:TestbedContext
    rdf:type            owl:Class ;
    rdfs:label          "Testbed Context"@en ;
    rdfs:comment        "A structured description of the 5G/6G testbed infrastructure, service configuration, and experimentation parameters associated with a dataset, following the SNS-JU Common Metadata Template (CMT) V1.0."@en ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> ;
    rdfs:seeAlso        <https://bscw.sns-ju.eu/sec/bscw.cgi/606978> .


# =============================================================================
# 2. OBJECT PROPERTIES
# =============================================================================

dali:testbedContext
    rdf:type            owl:ObjectProperty ;
    rdfs:label          "testbed context"@en ;
    rdfs:comment        "Links a dcat:Dataset to a dali:TestbedContext resource describing the 5G/6G testbed and experiment conditions under which the dataset was produced."@en ;
    rdfs:domain         dcat:Dataset ;
    rdfs:range          dali:TestbedContext ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:underlayPlatform
    rdf:type            owl:ObjectProperty ;
    rdfs:label          "underlay platform"@en ;
    rdfs:comment        "Reference URI to the testbed platform used to collect the data (e.g., link to Victoria Network UMA/ITIS, 5TONIC, etc.)."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .


# =============================================================================
# 3. DATATYPE PROPERTIES — Dataset level
# =============================================================================

dali:snsProjectName
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "SNS project name"@en ;
    rdfs:comment        "Name of the SNS-JU project that produced this dataset (e.g., '6G-DALI', 'FIDAL', '6G-SANDBOX')."@en ;
    rdfs:domain         dcat:Dataset ;
    rdfs:range          xsd:string ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:gdprCompliant
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "GDPR compliant"@en ;
    rdfs:comment        "Boolean declaration by the dataset owner confirming that the dataset complies with GDPR requirements."@en ;
    rdfs:domain         dcat:Dataset ;
    rdfs:range          xsd:boolean ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:fairCompliant
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "FAIR compliant"@en ;
    rdfs:comment        "Boolean declaration by the dataset owner confirming that the dataset adheres to the FAIR (Findable, Accessible, Interoperable, Reusable) principles."@en ;
    rdfs:domain         dcat:Dataset ;
    rdfs:range          xsd:boolean ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .


# =============================================================================
# 4. DATATYPE PROPERTIES — TestbedContext: CMT Group 3A (Infrastructure)
# =============================================================================

dali:environment
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "environment"@en ;
    rdfs:comment        "Physical environment in which the measurements were collected. Allowed values: indoors, urban, rural, mixed."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:seeAlso        dali:EnvironmentScheme ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:networkDomain
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "network domain"@en ;
    rdfs:comment        "The network infrastructure domain(s) involved. Allowed values: RAN, Transport, CORE, E2E."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:seeAlso        dali:NetworkDomainScheme ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:computeInfrastructureType
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "compute infrastructure type"@en ;
    rdfs:comment        "Type of compute infrastructure used (e.g., 'private-edge node', 'central cloud')."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

# --- RAN properties ---

dali:ran3gppRelease
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "RAN 3GPP release"@en ;
    rdfs:comment        "3GPP release of the RAN deployment (e.g., 'Release 17')."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:ranNewRadioType
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "new radio type"@en ;
    rdfs:comment        "New Radio deployment type. Allowed values: NR-SA, NR-NSA, LTE."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:seeAlso        dali:NRTypeScheme ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:ranSplit
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "RAN split"@en ;
    rdfs:comment        "Functional split used in the RAN deployment. Allowed values: DU-RU split, No-Split, CU-DU split."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:seeAlso        dali:RANSplitScheme ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:ranFocusedTechnology
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "RAN focused technology"@en ;
    rdfs:comment        "Primary technology focus of the RAN deployment. Allowed values: O-RAN, JSAC, RIC, No_focus."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:seeAlso        dali:RANTechnologyScheme ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:ranCoverageType
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "coverage type"@en ;
    rdfs:comment        "RAN coverage configuration. Allowed values: Single_Macro, Single_Micro, Multicell_setup."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:seeAlso        dali:CoverageTypeScheme ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:ranFrequencyBand
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "RAN frequency band"@en ;
    rdfs:comment        "Frequency band used (e.g., 'n78', '3.5GHz', '2.61GHz')."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:ranBandwidthMHz
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "RAN bandwidth (MHz)"@en ;
    rdfs:comment        "Channel bandwidth in MHz."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:integer ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:ranMaxEndDevices
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "max end devices"@en ;
    rdfs:comment        "Maximum number of end devices (UEs) involved in the experiment."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:integer ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:ranMobilityModel
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "end device mobility model"@en ;
    rdfs:comment        "Mobility model of the end devices. Allowed values: static, pedestrian, vehicular, UAV, mixed."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:seeAlso        dali:MobilityModelScheme ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

# --- Core properties ---

dali:coreRelease
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "core 3GPP release"@en ;
    rdfs:comment        "3GPP release of the network core deployment (e.g., 'Release 17')."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:coreSolution
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "core solution"@en ;
    rdfs:comment        "Type of network core solution. Allowed values: OpenSource, Commercial."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:seeAlso        dali:CoreSolutionScheme ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

# --- Transport properties ---

dali:transportType
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "transport type"@en ;
    rdfs:comment        "Type of transport network. Allowed values: wired, microwave, fiber_optics, satellite, mixed."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:seeAlso        dali:TransportTypeScheme ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

# --- Compute properties ---

dali:computeOrchestratorType
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "compute orchestrator type"@en ;
    rdfs:comment        "Orchestration platform used. Allowed values: Kubernetes, OpenStack, openSlice, ONAP, OSM, None."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:seeAlso        dali:OrchestratorScheme ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:computeGpuUse
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "GPU use"@en ;
    rdfs:comment        "Boolean indicating whether GPUs were used in the compute environment."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:boolean ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:computeVirtualizationType
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "virtualisation type"@en ;
    rdfs:comment        "Virtualisation technology used. Allowed values: KVM, Docker, Bare-metal, mixed."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:seeAlso        dali:VirtualizationScheme ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .


# =============================================================================
# 5. DATATYPE PROPERTIES — TestbedContext: CMT Group 3B (Service description)
# =============================================================================

dali:trafficOrigin
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "traffic origin"@en ;
    rdfs:comment        "Origin of the traffic in the experiment. Allowed values: Manual, Application."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:seeAlso        dali:TrafficOriginScheme ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:trafficPattern
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "traffic pattern"@en ;
    rdfs:comment        "Traffic direction and protocol pattern (e.g., 'DL UDP', 'UL/DL TCP')."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:seeAlso        dali:TrafficPatternScheme ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:sliceType
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "slice type"@en ;
    rdfs:comment        "Network slice type used in the experiment (e.g., 'slice101', 'Multi-slice', 'No_slicing')."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:referencePlane
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "reference plane"@en ;
    rdfs:comment        "Network plane where measurements were collected. Allowed values: control plane, data plane, management plane."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:seeAlso        dali:ReferencePlaneScheme ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:relatedVertical
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "related vertical"@en ;
    rdfs:comment        "Industry vertical related to the experiment (e.g., 'Vertical_agnostic', 'CAM', 'HEALTH')."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .


# =============================================================================
# 6. DATATYPE PROPERTIES — TestbedContext: CMT Group 3C (Experimentation metrics)
# =============================================================================

dali:observationPointHorizontal
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "observation point (horizontal)"@en ;
    rdfs:comment        "Horizontal observation point in the 5G architecture (per SNS-JU CMT Annex 1). Allowed values: E2E Application layer, End device to Access, DU to CU, Access to Edge, Access to Core, Core to Cloud."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:seeAlso        dali:ObservationPointHScheme ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:observationPointVertical
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "observation point (vertical)"@en ;
    rdfs:comment        "Vertical observation layer in the protocol stack. Allowed values: Radio Level, Network Layer, Application Layer, Compute Resource-level, cross-layer, other."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:seeAlso        dali:ObservationPointVScheme ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:measurementFamily
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "measurement family"@en ;
    rdfs:comment        "3GPP TS 28.552 measurement family code (e.g., DRB, RRU, L1M, PEE, QF). Multiple values allowed."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:measurementTool
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "measurement tool"@en ;
    rdfs:comment        "Tool or software used to collect the measurements (e.g., 'tcpdump', 'Prometheus exporter'). Multiple values allowed."@en ;
    rdfs:domain         dali:TestbedContext ;
    rdfs:range          xsd:string ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .


# =============================================================================
# 7. DATATYPE PROPERTIES — DataService
# =============================================================================

dali:serviceType
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "service type"@en ;
    rdfs:comment        "Nature of the DataOps service. Allowed values: Transformation, QualityCheck, Augmentation, Aggregation, Anonymisation, Feature Engineering."@en ;
    rdfs:domain         dcat:DataService ;
    rdfs:range          xsd:string ;
    rdfs:seeAlso        dali:ServiceTypeScheme ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:inputFormat
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "input format"@en ;
    rdfs:comment        "Expected IANA media type of input data consumed by the service (e.g., 'text/csv')."@en ;
    rdfs:domain         dcat:DataService ;
    rdfs:range          xsd:string ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:outputFormat
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "output format"@en ;
    rdfs:comment        "Produced IANA media type of output data from the service."@en ;
    rdfs:domain         dcat:DataService ;
    rdfs:range          xsd:string ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:framework
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "processing framework"@en ;
    rdfs:comment        "Software framework used by the data service (e.g., 'Apache Spark', 'Great Expectations', 'Apache Kafka')."@en ;
    rdfs:domain         dcat:DataService ;
    rdfs:range          xsd:string ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .


# =============================================================================
# 8. DATATYPE PROPERTIES — ML Model
# =============================================================================

dali:trainingSplit
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "training split"@en ;
    rdfs:comment        "Fraction of the dataset used for model training (0.0–1.0)."@en ;
    rdfs:domain         mldcat:MLModel ;
    rdfs:range          xsd:decimal ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:trainingHardware
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "training hardware"@en ;
    rdfs:comment        "Hardware platform used for model training (e.g., 'NVIDIA A100 40GB GPU (x4)')."@en ;
    rdfs:domain         mldcat:MLModel ;
    rdfs:range          xsd:string ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:trainingComputeEnv
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "training compute environment"@en ;
    rdfs:comment        "Compute infrastructure used for model training (e.g., 'Kubernetes cluster', 'HPC cluster')."@en ;
    rdfs:domain         mldcat:MLModel ;
    rdfs:range          xsd:string ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:biasMitigationApplied
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "bias mitigation applied"@en ;
    rdfs:comment        "Description of bias mitigation techniques applied during training, or false if none."@en ;
    rdfs:domain         mldcat:MLModel ;
    rdfs:range          xsd:string ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .

dali:protectedAttributes
    rdf:type            owl:DatatypeProperty ;
    rdfs:label          "protected attributes"@en ;
    rdfs:comment        "Demographic or sensitive attributes checked for fairness during model evaluation."@en ;
    rdfs:domain         mldcat:MLModel ;
    rdfs:range          xsd:string ;
    rdfs:isDefinedBy    <https://dali-project.eu/ns> .


# =============================================================================
# 9. CONTROLLED VOCABULARIES (SKOS Concept Schemes)
# =============================================================================

# --- Environment ---

dali:EnvironmentScheme
    rdf:type        skos:ConceptScheme ;
    skos:prefLabel  "6G-DALI Environment Types"@en ;
    dct:description "Allowed values for dali:environment."@en .

dali:env-indoors   rdf:type skos:Concept ; skos:prefLabel "indoors"@en   ; skos:inScheme dali:EnvironmentScheme ; skos:notation "indoors" .
dali:env-urban     rdf:type skos:Concept ; skos:prefLabel "urban"@en     ; skos:inScheme dali:EnvironmentScheme ; skos:notation "urban" .
dali:env-rural     rdf:type skos:Concept ; skos:prefLabel "rural"@en     ; skos:inScheme dali:EnvironmentScheme ; skos:notation "rural" .
dali:env-mixed     rdf:type skos:Concept ; skos:prefLabel "mixed"@en     ; skos:inScheme dali:EnvironmentScheme ; skos:notation "mixed" .

# --- Network Domain ---

dali:NetworkDomainScheme
    rdf:type        skos:ConceptScheme ;
    skos:prefLabel  "6G-DALI Network Domains"@en ;
    dct:description "Allowed values for dali:networkDomain."@en .

dali:nd-ran        rdf:type skos:Concept ; skos:prefLabel "RAN"@en       ; skos:inScheme dali:NetworkDomainScheme ; skos:notation "RAN" .
dali:nd-transport  rdf:type skos:Concept ; skos:prefLabel "Transport"@en ; skos:inScheme dali:NetworkDomainScheme ; skos:notation "Transport" .
dali:nd-core       rdf:type skos:Concept ; skos:prefLabel "CORE"@en      ; skos:inScheme dali:NetworkDomainScheme ; skos:notation "CORE" .
dali:nd-e2e        rdf:type skos:Concept ; skos:prefLabel "E2E"@en       ; skos:inScheme dali:NetworkDomainScheme ; skos:notation "E2E" .

# --- New Radio Type ---

dali:NRTypeScheme
    rdf:type        skos:ConceptScheme ;
    skos:prefLabel  "6G-DALI New Radio Types"@en ;
    dct:description "Allowed values for dali:ranNewRadioType."@en .

dali:nr-sa         rdf:type skos:Concept ; skos:prefLabel "NR-SA"@en     ; skos:inScheme dali:NRTypeScheme ; skos:notation "NR-SA" .
dali:nr-nsa        rdf:type skos:Concept ; skos:prefLabel "NR-NSA"@en    ; skos:inScheme dali:NRTypeScheme ; skos:notation "NR-NSA" .
dali:nr-lte        rdf:type skos:Concept ; skos:prefLabel "LTE"@en       ; skos:inScheme dali:NRTypeScheme ; skos:notation "LTE" .

# --- RAN Split ---

dali:RANSplitScheme
    rdf:type        skos:ConceptScheme ;
    skos:prefLabel  "6G-DALI RAN Split Types"@en ;
    dct:description "Allowed values for dali:ranSplit."@en .

dali:split-du-ru   rdf:type skos:Concept ; skos:prefLabel "DU-RU split"@en  ; skos:inScheme dali:RANSplitScheme ; skos:notation "DU-RU split" .
dali:split-none    rdf:type skos:Concept ; skos:prefLabel "No-Split"@en      ; skos:inScheme dali:RANSplitScheme ; skos:notation "No-Split" .
dali:split-cu-du   rdf:type skos:Concept ; skos:prefLabel "CU-DU split"@en  ; skos:inScheme dali:RANSplitScheme ; skos:notation "CU-DU split" .

# --- RAN Focused Technology ---

dali:RANTechnologyScheme
    rdf:type        skos:ConceptScheme ;
    skos:prefLabel  "6G-DALI RAN Technologies"@en ;
    dct:description "Allowed values for dali:ranFocusedTechnology."@en .

dali:tech-oran     rdf:type skos:Concept ; skos:prefLabel "O-RAN"@en     ; skos:inScheme dali:RANTechnologyScheme ; skos:notation "O-RAN" .
dali:tech-jsac     rdf:type skos:Concept ; skos:prefLabel "JSAC"@en      ; skos:inScheme dali:RANTechnologyScheme ; skos:notation "JSAC" .
dali:tech-ric      rdf:type skos:Concept ; skos:prefLabel "RIC"@en       ; skos:inScheme dali:RANTechnologyScheme ; skos:notation "RIC" .
dali:tech-nofocus  rdf:type skos:Concept ; skos:prefLabel "No focus"@en  ; skos:inScheme dali:RANTechnologyScheme ; skos:notation "No_focus" .

# --- Coverage Type ---

dali:CoverageTypeScheme
    rdf:type        skos:ConceptScheme ;
    skos:prefLabel  "6G-DALI Coverage Types"@en ;
    dct:description "Allowed values for dali:ranCoverageType."@en .

dali:cov-macro     rdf:type skos:Concept ; skos:prefLabel "Single Macro"@en    ; skos:inScheme dali:CoverageTypeScheme ; skos:notation "Single_Macro" .
dali:cov-micro     rdf:type skos:Concept ; skos:prefLabel "Single Micro"@en    ; skos:inScheme dali:CoverageTypeScheme ; skos:notation "Single_Micro" .
dali:cov-multi     rdf:type skos:Concept ; skos:prefLabel "Multicell setup"@en ; skos:inScheme dali:CoverageTypeScheme ; skos:notation "Multicell_setup" .

