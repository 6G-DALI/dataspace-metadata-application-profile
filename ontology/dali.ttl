dali:ObservationPointHScheme
    rdf:type        skos:ConceptScheme ;
    skos:prefLabel  "6G-DALI Horizontal Observation Points"@en ;
    dct:description "Horizontal observation points per SNS-JU CMT Annex 1 (5GPP Arch WG View on 5G Architecture)."@en .

dali:obs-h-e2e       rdf:type skos:Concept ; skos:prefLabel "E2E Application layer"@en    ; skos:inScheme dali:ObservationPointHScheme ; skos:notation "E2E Application layer" .
dali:obs-h-ue-access rdf:type skos:Concept ; skos:prefLabel "End device to Access"@en     ; skos:inScheme dali:ObservationPointHScheme ; skos:notation "End device to Access" .
dali:obs-h-du-cu     rdf:type skos:Concept ; skos:prefLabel "DU to CU"@en                 ; skos:inScheme dali:ObservationPointHScheme ; skos:notation "DU to CU" .
dali:obs-h-acc-edge  rdf:type skos:Concept ; skos:prefLabel "Access to Edge"@en            ; skos:inScheme dali:ObservationPointHScheme ; skos:notation "Access to Edge" .
dali:obs-h-acc-core  rdf:type skos:Concept ; skos:prefLabel "Access to Core"@en            ; skos:inScheme dali:ObservationPointHScheme ; skos:notation "Access to Core" .
dali:obs-h-core-cld  rdf:type skos:Concept ; skos:prefLabel "Core to Cloud"@en             ; skos:inScheme dali:ObservationPointHScheme ; skos:notation "Core to Cloud" .

