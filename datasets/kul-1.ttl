                                   schema:name        "Research Foundation Flanders (FWO)" ] ;

    # --- Schema.org additional fields ---
    schema:about                 "3D non-stationary channel measurements for UAV-to-ground massive MIMO communications featuring comprehensive stationarity analysis in space, time, and frequency domains. Measurements conducted at multiple UAV altitudes with 64-antenna base station and drone-mounted user equipment."@en ;
    schema:applicationCategory   "Urban Air Mobility" , "6G Research" , "Massive MIMO" ,
                                 "Wireless Propagation" , "UAV Communications" , "Channel Modeling" ;
    schema:description           "Novel stationary angle metric introduced for MaMIMO beam tracking. Stationary distance ranges 2.2-3.6m, stationary angle 8.7-11.5°. Higher altitude UAVs show increased channel stability. Comprehensive space-time-frequency stationarity characterization for physical layer design."@en ;
    schema:datePublished         "2023-10-10"^^xsd:date ;
    schema:isAccessibleForFree   true ;
    schema:isRelatedTo           "Massive MIMO Channel Measurement Data Set for Localization and Communication"@en ;
    schema:url                   <https://doi.org/10.48804/0IMQDF> ;

