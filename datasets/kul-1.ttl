    dali:testbedContext          [
        rdf:type                         dali:TestbedContext ;
        dali:underlayPlatform            <https://www.esat.kuleuven.be/wavecore/> ;
        dali:environment                 "urban" ;
        dali:networkDomain               "RAN" ;
        dali:ran3gppRelease              "Release 15" ;
        dali:ranFocusedTechnology        "No_focus" ;
        dali:ranCoverageType             "Single_Macro" ;
        dali:ranFrequencyBand            "Sub-6GHz" ;
        dali:ranMaxEndDevices            1 ;
        dali:ranMobilityModel            "UAV" ;
        dali:observationPointHorizontal  "End device to Access" ;
        dali:observationPointVertical    "Radio Level" ;
        dali:measurementFamily           "L1M" ;
        dali:measurementTool             "MaMIMO testbed (custom 64-antenna), GPS-synchronized drone" ;
    ] ;

    # --- Measured variables ---
    schema:variableMeasured      "Channel State Information (CSI), Power Delay Profiles (PDP), Spatial Correlation Matrices"@en ;
    schema:measurementTechnique  "OFDM-based channel sounding using 64-antenna MaMIMO testbed with GPS-synchronized drone-mounted user equipment"@en ;

    # --- Provenance ---
    dct:provenance               [ rdf:type    dct:ProvenanceStatement ;
                                   rdfs:label  "Collected by KU Leuven WaveCoRE MaMIMO testbed during a UAV measurement campaign at KU Leuven Campus, Leuven, Belgium. Data uploaded to the 6G-DALI Data Space."@en ] ;
    prov:wasAttributedTo         <https://dataspace.6gdali.eu/participant/ku-leuven> ;

