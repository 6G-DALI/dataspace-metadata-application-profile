                                   foaf:mbox           <mailto:evgenii.vinogradov@tii.ae> ;
                                   schema:affiliation  "KU Leuven ESAT and Technology Innovation Institute (TII), Abu Dhabi, UAE" ] ;
    dct:creator                  [ rdf:type            foaf:Person ;
                                   foaf:name           "Sofie Pollin" ;
                                   foaf:mbox           <mailto:sofie.pollin@kuleuven.be> ;
                                   schema:affiliation  "KU Leuven - WaveCoRE, Department of Electrical Engineering (ESAT)" ] ;
    dcat:contactPoint            [ rdf:type        vcard:Organization ;
