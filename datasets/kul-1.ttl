# =============================================================================
# Dataset: 3D Non-Stationary Channel Measurement for MaMIMO-UAV Communications
# Producer: KU Leuven WaveCoRE (IMEC)
# =============================================================================

<https://dataspace.6gdali.eu/set/data/dali-dataset-3>
    rdf:type                     dcat:Dataset, gax:DataResource ;

    # --- Core identity ---
    dct:title                    "3D Non-Stationary Channel Measurement and Analysis for MaMIMO-UAV Communications"@en ;
    dct:description              "Comprehensive 3D UAV Massive MIMO channel measurement dataset for air-to-ground (A2G) communications featuring multi-dimensional channel stationarity analysis. Dataset includes Channel State Information (CSI) measurements from a 64-antenna base station and drone-mounted user equipment at three different altitudes (8m, 11m, 24m). Features novel stationary angle metric, space-time-frequency channel analysis, and comprehensive non-stationarity characterization for 6G UAV communications research."@en ;
    dct:identifier               "0IMQDF" ;
    dct:issued                   "2023-10-10"^^xsd:date ;
    dct:modified                 "2023-12-11"^^xsd:date ;
    dct:language                 <http://publications.europa.eu/resource/authority/language/ENG> ;
    adms:version                 "v2" ;
    adms:identifier              [ rdf:type            adms:Identifier ;
                                   skos:notation       "10.48804/0IMQDF" ;
                                   adms:schemeAgency   "DataCite" ] ;

    # --- Access & license ---
    dct:accessRights             <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dct:license                  <https://creativecommons.org/licenses/by/4.0/> ;
    dct:rights                   "Open Access"@en ;

    # --- Publisher, creators, contact ---
    dct:creator                  [ rdf:type            foaf:Person ;
                                   foaf:name           "Achiel Colpaert" ;
                                   foaf:mbox           <mailto:achiel.colpaert@imec.be> ;
                                   schema:affiliation  "IMEC and KU Leuven - WaveCoRE, Department of Electrical Engineering (ESAT)" ] ;
