    schema:funding               [ rdf:type           schema:Grant ;
                                   schema:funder      "EU Horizon Europe Research and Innovation Programme" ;
                                   schema:identifier  "101139291" ;
                                   schema:name        "iSEE-6G Project" ] ;
    schema:funding               [ rdf:type           schema:Grant ;
