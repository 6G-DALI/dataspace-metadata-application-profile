                                 "urban air mobility"@en , "drone"@en , "RMS delay spread"@en ,
                                 "frequency stationarity"@en , "Massive MIMO"@en ,
                                 "UAV communications"@en , "beamforming"@en ,
                                 "MaMIMO testbed"@en , "non-stationary channels"@en ,
                                 "temporal stationarity"@en , "power delay profile"@en ,
