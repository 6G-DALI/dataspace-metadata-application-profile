# 6G-DALI SHACL Shapes — Data Quality (W3C DQV)
# Defines validation shapes for dqv:QualityMeasurement, dqv:Metric,
# and dqv:QualityPolicy resources used to annotate datasets and ML models
# with quality information, including results from Great Expectations suites.
#
# Severity levels:
#   sh:Violation  — Mandatory (M)
#   sh:Warning    — Recommended (R)

PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX dqv:    <http://www.w3.org/ns/dqv#>
PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX prov:   <http://www.w3.org/ns/prov#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX dali:   <https://dali-project.eu/ns#>

# ---------------------------------------------------------------------------
# dali:QualityMeasurementShape
# Node shape for dqv:QualityMeasurement instances.
# Used to record concrete quality values on datasets and ML models,
# including Great Expectations validation results.
# ---------------------------------------------------------------------------

dali:QualityMeasurementShape
    a           sh:NodeShape ;
    sh:name     "6G-DALI Quality Measurement" ;
    sh:description "Shape for dqv:QualityMeasurement resources recording quality metric results on datasets or ML models." ;
    sh:targetClass  dqv:QualityMeasurement ;

    sh:property [
        sh:path         dqv:isMeasurementOf ;
        sh:name         "Is measurement of" ;
        sh:description  "Reference to the dqv:Metric being measured." ;
        sh:minCount     1 ;
        sh:nodeKind     sh:IRI ;
        sh:class        dqv:Metric ;
        sh:severity     sh:Violation ;
        sh:message      "dqv:isMeasurementOf is mandatory and must reference a dqv:Metric IRI."@en ;
    ] ;

    sh:property [
        sh:path         dqv:computedOn ;
        sh:name         "Computed on" ;
        sh:description  "Reference to the dcat:Dataset or mldcat:MLModel this measurement applies to." ;
        sh:minCount     1 ;
        sh:nodeKind     sh:IRI ;
        sh:severity     sh:Violation ;
        sh:message      "dqv:computedOn is mandatory and must reference the assessed resource IRI."@en ;
    ] ;

    sh:property [
        sh:path         dqv:value ;
        sh:name         "Measured value" ;
        sh:description  "Numeric or boolean result of the quality measurement." ;
        sh:minCount     1 ;
        sh:severity     sh:Violation ;
        sh:message      "dqv:value is mandatory."@en ;
    ] ;

    sh:property [
        sh:path         dct:date ;
        sh:name         "Measurement date" ;
        sh:description  "Date when the measurement was computed." ;
        sh:minCount     1 ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:dateTime ]
        ) ;
        sh:severity     sh:Violation ;
        sh:message      "dct:date is mandatory on dqv:QualityMeasurement."@en ;
    ] ;

    sh:property [
        sh:path         prov:wasGeneratedBy ;
        sh:name         "Generated by" ;
        sh:description  "Service or activity that produced this measurement (e.g., the quality checker DataService)." ;
        sh:nodeKind     sh:IRI ;
        sh:severity     sh:Warning ;
        sh:message      "prov:wasGeneratedBy is recommended (link to the quality checking service)."@en ;
    ] ;

    sh:property [
        sh:path         dct:description ;
        sh:name         "Description" ;
        sh:description  "Human-readable interpretation of the measurement result." ;
        sh:datatype     rdf:langString ;
        sh:severity     sh:Warning ;
        sh:message      "dct:description is recommended on dqv:QualityMeasurement."@en ;
    ] .


# ---------------------------------------------------------------------------
# dali:MetricShape
# Node shape for dqv:Metric instances.
# Defines individual quality criteria (Great Expectations: Expectations).
# ---------------------------------------------------------------------------

dali:MetricShape
    a           sh:NodeShape ;
    sh:name     "6G-DALI Quality Metric" ;
    sh:description "Shape for dqv:Metric resources defining quality criteria for datasets or ML models." ;
    sh:targetClass  dqv:Metric ;

    sh:property [
        sh:path         rdfs:label ;
        sh:name         "Label" ;
        sh:description  "Human-readable name of the metric." ;
        sh:minCount     1 ;
        sh:datatype     rdf:langString ;
        sh:severity     sh:Violation ;
        sh:message      "rdfs:label is mandatory on dqv:Metric."@en ;
    ] ;

    sh:property [
        sh:path         dqv:inDimension ;
        sh:name         "In dimension" ;
        sh:description  "Quality dimension this metric belongs to (e.g., dali:dqv/completeness)." ;
        sh:minCount     1 ;
        sh:nodeKind     sh:IRI ;
        sh:class        dqv:Dimension ;
        sh:severity     sh:Violation ;
        sh:message      "dqv:inDimension is mandatory on dqv:Metric."@en ;
    ] ;

    sh:property [
        sh:path         dct:description ;
        sh:name         "Description" ;
        sh:description  "Explanation of what this metric measures and how it maps to a Great Expectations expectation if applicable." ;
        sh:datatype     rdf:langString ;
        sh:severity     sh:Warning ;
        sh:message      "dct:description is recommended on dqv:Metric."@en ;
    ] ;

    sh:property [
        sh:path         dqv:expectedDataType ;
        sh:name         "Expected data type" ;
        sh:description  "Expected XSD datatype for the measured value." ;
        sh:nodeKind     sh:IRI ;
        sh:severity     sh:Warning ;
        sh:message      "dqv:expectedDataType is recommended on dqv:Metric."@en ;
    ] .


# ---------------------------------------------------------------------------
# dali:DimensionShape
# Node shape for dqv:Dimension instances.
# ---------------------------------------------------------------------------

dali:DimensionShape
    a           sh:NodeShape ;
    sh:name     "6G-DALI Quality Dimension" ;
    sh:targetClass  dqv:Dimension ;

    sh:property [
        sh:path     rdfs:label ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:severity sh:Violation ;
        sh:message  "rdfs:label is mandatory on dqv:Dimension."@en ;
    ] ;

    sh:property [
        sh:path     rdfs:comment ;
        sh:datatype rdf:langString ;
        sh:severity sh:Warning ;
        sh:message  "rdfs:comment is recommended on dqv:Dimension."@en ;
    ] .


# ---------------------------------------------------------------------------
# dali:QualityPolicyShape
# Node shape for dqv:QualityPolicy instances.
# In the 6G-DALI context a quality policy corresponds to a
# Great Expectations Expectation Suite.
# ---------------------------------------------------------------------------

dali:QualityPolicyShape
    a           sh:NodeShape ;
    sh:name     "6G-DALI Quality Policy" ;
    sh:description "Shape for dqv:QualityPolicy resources representing Great Expectations suites or other sets of quality rules." ;
    sh:targetClass  dqv:QualityPolicy ;

    sh:property [
        sh:path         rdfs:label ;
        sh:name         "Label" ;
        sh:description  "Human-readable name of the quality policy / expectation suite." ;
        sh:minCount     1 ;
        sh:datatype     rdf:langString ;
        sh:severity     sh:Violation ;
        sh:message      "rdfs:label is mandatory on dqv:QualityPolicy."@en ;
    ] ;

    sh:property [
        sh:path         dct:description ;
        sh:name         "Description" ;
        sh:datatype     rdf:langString ;
        sh:severity     sh:Warning ;
        sh:message      "dct:description is recommended on dqv:QualityPolicy."@en ;
    ] ;

    sh:property [
        sh:path         dct:creator ;
        sh:name         "Creator" ;
        sh:description  "Organisation or person who defined the quality policy." ;
        sh:nodeKind     sh:BlankNodeOrIRI ;
        sh:severity     sh:Warning ;
        sh:message      "dct:creator is recommended on dqv:QualityPolicy."@en ;
    ] .


# ---------------------------------------------------------------------------
# dali:QualityAnnotationShape
# Node shape for dqv:QualityAnnotation instances.
# Used for human-readable quality reports (e.g., Great Expectations Data Docs).
# ---------------------------------------------------------------------------

dali:QualityAnnotationShape
    a           sh:NodeShape ;
    sh:name     "6G-DALI Quality Annotation" ;
    sh:targetClass  dqv:QualityAnnotation ;

    sh:property [
        sh:path         oa:motivatedBy ;
        sh:name         "Motivated by" ;
        sh:description  "Motivation for the annotation; must be dqv:qualityAssessment." ;
        sh:minCount     1 ;
        sh:hasValue     dqv:qualityAssessment ;
        sh:severity     sh:Violation ;
        sh:message      "oa:motivatedBy must be dqv:qualityAssessment on dqv:QualityAnnotation."@en ;
    ] ;

    sh:property [
        sh:path         oa:hasBody ;
        sh:name         "Annotation body" ;
        sh:description  "URI of the quality report document (e.g., Great Expectations Data Docs HTML)." ;
        sh:minCount     1 ;
        sh:nodeKind     sh:IRI ;
        sh:severity     sh:Violation ;
        sh:message      "oa:hasBody is mandatory on dqv:QualityAnnotation."@en ;
    ] ;

    sh:property [
        sh:path         dct:date ;
        sh:or (
            [ sh:datatype xsd:date ]
            [ sh:datatype xsd:dateTime ]
        ) ;
        sh:severity     sh:Warning ;
        sh:message      "dct:date is recommended on dqv:QualityAnnotation."@en ;
    ] .